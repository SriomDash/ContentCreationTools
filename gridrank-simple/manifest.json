{
  "manifest_version": 3,
  "name": "GridRank — Sort Creator Feeds",
  "version": "1.0.0",
  "description": "Rank a creator's public posts by views, likes, or comments while you browse. Date range, filters, and one-click Excel export. For your own research.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.instagram.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["xlsx.full.min.js", "export.js", "panel.js"],
      "css": ["panel.css"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
